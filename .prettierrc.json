{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 130,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "supabase/functions/**/*.ts",
      "options": { "printWidth": 100, "trailingComma": "all" }
    }
  ]
}
