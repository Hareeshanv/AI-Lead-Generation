# General Configuration
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ai_lead_gen?schema=public"

# Supabase (server-side; used by the API — keep the service role key secret)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase (public; used by the web app, and by the API as a fallback)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Web app → API
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# AI / LLM Model API Keys
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-..."

# Storage (S3 / MinIO)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="ai-lead-gen-storage"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadminpassword"

# External Integrations & CRMs
HUBSPOT_API_KEY=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SLACK_WEBHOOK_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Sarvam AI (chat completions: POST {SARVAM_API_BASE_URL}/v1/chat/completions)
SARVAM_API_KEY=""
SARVAM_API_BASE_URL="https://api.sarvam.ai"
# sarvam-m is deprecated by the API. sarvam-105b-conversations answers in ~1s;
# sarvam-105b is a reasoning model (much slower, spends thousands of hidden reasoning tokens).
SARVAM_MODEL="sarvam-105b-conversations"
# Set to 1 only for offline development; simulated runs always report success:false
SARVAM_SIMULATE=""

# Meta Lead Ads (Facebook Login for Business + leadgen webhooks)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_REDIRECT_URI="http://localhost:4000/api/integrations/meta/callback"

# Base URL of the lead-webhook edge function host (defaults to SUPABASE_URL)
PUBLIC_WEBHOOK_BASE_URL=""
# Web app URL the API redirects to after Meta OAuth
WEB_APP_URL="http://localhost:3000"

# Optional LLM search fallback (used when Sarvam search returns no leads)
GROQ_API_KEY=""

# Serper.dev (Google Search API) key for the Student Discovery Agent
SERPER_API_KEY=""

# Campaigns: server-wide fallbacks; per-workspace credentials saved under Integrations take precedence.
# Resend (email). Webhook: POST {API_PUBLIC_URL}/api/webhooks/resend (email.* events)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME=""
RESEND_WEBHOOK_SECRET=""
# WhatsApp Cloud API. Webhook: {API_PUBLIC_URL}/api/webhooks/whatsapp (or /api/webhooks/whatsapp/<org id>)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Country code added to 10-digit lead phone numbers before sending on WhatsApp
WHATSAPP_DEFAULT_COUNTRY_CODE="91"
# Public URL of this API (e.g. an ngrok tunnel); used in email unsubscribe links
API_PUBLIC_URL="http://localhost:4000"
# Signs unsubscribe links (falls back to SUPABASE_SERVICE_ROLE_KEY)
CAMPAIGN_UNSUBSCRIBE_SECRET=""

# Outbound webhook (workflow actions + integration test). Requests carry X-Signature: sha256=<hmac of body>
OUTBOUND_WEBHOOK_URL=""
OUTBOUND_WEBHOOK_SECRET=""
# Minutes between integration health checks (minimum 5)
INTEGRATION_HEALTH_CHECK_MINUTES="60"

# Development only: auto sign-in as an admin of the Default Workspace (ignored when NODE_ENV=production).
# Also set NEXT_PUBLIC_DEV_AUTO_LOGIN=true for the web app.
DEV_AUTO_LOGIN=false
DEV_LOGIN_EMAIL=dev@leadgen.local
DEV_LOGIN_PASSWORD=
NEXT_PUBLIC_DEV_AUTO_LOGIN=false
