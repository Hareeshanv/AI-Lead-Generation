# General Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ai_lead_gen?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# AI / LLM Model API Keys
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-..."

# Storage (S3 / MinIO)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="ai-lead-gen-storage"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadminpassword"

# External Integrations & CRMs
HUBSPOT_API_KEY=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SLACK_WEBHOOK_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
